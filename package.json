{
  "name": "tnj3d-gestao",
  "version": "1.0.0",
  "private": true,
  "description": "Site de gestão e calculadora de custos para impressão 3D (TNJ.3D) — GitHub Pages + Google Apps Script.",
  "scripts": {
    "dev": "http-server . -p 8080 -c-1 -o",
